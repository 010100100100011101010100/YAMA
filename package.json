{
  "name": "yama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:frontend && npm run test:backend",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:frontend": "vitest run",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:agents": "python3 -m unittest discover -s tests -v",
    "test:providers": ".venv/bin/python -m unittest discover -s tests -p 'test_openai*.py' -v",
    "agents:setup": "sh scripts/setup-agents.sh",
    "db:setup": "node scripts/database/setup.mjs",
    "db:up": "node scripts/database/control.mjs up",
    "db:down": "node scripts/database/control.mjs down",
    "db:status": "node scripts/database/control.mjs status",
    "db:init": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/init.ts",
    "worker:graph": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/graph-worker.ts",
    "evidence:setup": "node scripts/database/setup-evidence.mjs",
    "worker:evidence": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/evidence-worker.ts",
    "worker:agents": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/agent-worker.ts",
    "voice:setup": "sh scripts/setup-voice.sh && node scripts/voice/setup.mjs",
    "voice:server:setup": "sh scripts/setup-livekit.sh",
    "voice:server": ".local/runtime/bin/livekit-server --config .local/secrets/livekit-native.yaml",
    "worker:voice": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/voice-worker.ts",
    "test:voice": ".venv-voice/bin/python -m unittest discover -s tests/voice -v",
    "db:requeue-graph": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/requeue-graph.ts",
    "web:setup": "node scripts/public-web/setup.mjs",
    "worker:web": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/public-web-worker.ts",
    "mail:setup": "node scripts/notifications/setup.mjs",
    "mail:recipient": "node --conditions=react-server --import tsx --env-file=.env.local scripts/notifications/register-recipient.ts",
    "worker:mail": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/notification-worker.ts",
    "billing:setup": "node scripts/billing/setup.mjs",
    "worker:billing": "node --conditions=react-server --import tsx --env-file=.env.local scripts/database/billing-worker.ts"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "@redis/client": "5.12.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "2.54.2",
    "exa-js": "2.25.0",
    "falkordb": "6.8.0",
    "firecrawl": "4.46.0",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "^1.52.0",
    "mongodb": "^7.7.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "sanitize-html": "2.18.0",
    "server-only": "^0.0.1",
    "shadow-plugin": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
