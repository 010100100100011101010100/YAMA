# Local synthetic demo only. Run npm run db:setup to generate ignored secrets.
YAMA_DEMO_ONLY=true
# Omitted defaults to localhost. Docker defaults to hosted-demo; set this explicitly in Render.
YAMA_DEPLOYMENT_MODE=localhost
APP_ORIGIN=http://127.0.0.1:3000
MONGODB_URI=mongodb://yama:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:27018/yama?authSource=yama&replicaSet=yama-rs&directConnection=true
MONGODB_DATABASE=yama
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
MONGO_APP_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
# Keep local container credentials above; select cloud explicitly after db:check-graph -- --cloud passes.
YAMA_GRAPH_TARGET=local
YAMA_CLOUD_FALKORDB_HOST=
YAMA_CLOUD_FALKORDB_PORT=
YAMA_CLOUD_FALKORDB_USERNAME=
YAMA_CLOUD_FALKORDB_PASSWORD=
# Defaults to true if omitted. Set false only when the instance Connect panel specifies no TLS.
YAMA_CLOUD_FALKORDB_TLS=true
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional staged aliases, used only in hosted-demo mode when active values are absent/loopback.
# Otherwise set APP_ORIGIN to the exact frontend HTTPS origin and MONGODB_URI to Atlas directly.
YAMA_DEPLOYMENT_ORIGIN=
YAMA_CLOUD_MONGODB_URI=

# Text extraction + three-agent dialogue: fixtures by default. See docs/openai-extraction.md and docs/text-dialogue.md before enabling.
YAMA_TEXT_PROVIDER=fixture
YAMA_MODEL_LIVE_ENABLED=false
YAMA_OPENAI_DATA_POLICY_ACKNOWLEDGED=false
OPENAI_API_KEY=
# Explicit compatible Responses/Structured Outputs model; no paid default selection.
OPENAI_TEXT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
YAMA_OPENAI_MAX_OUTPUT_TOKENS=4096
YAMA_OPENAI_TIMEOUT_SECONDS=15
# Lifetime call reservations shared by extraction + every dialogue speaker across demo reports.
YAMA_OPENAI_MAX_CALLS=20
# Optional override; otherwise live jobs use .venv/bin/python.
YAMA_AGENT_PYTHON=
# Generated by scripts/setup-graphrag.sh; use a deployed SDK interpreter outside localhost.
YAMA_GRAPHRAG_PYTHON=
YAMA_SEMANTIC_MODEL_PATH=
# Enable after setup-semantic.py and db:index-semantic complete.
YAMA_SEMANTIC_RETRIEVAL_ENABLED=false

# Optional signed-in Codex text fallback for this private synthetic localhost demo.
# No OpenAI API key is used; native ChatGPT auth and account Codex quota are required.
# Set YAMA_TEXT_PROVIDER=codex and YAMA_CODEX_ENABLED=true to select it explicitly.
YAMA_CODEX_ENABLED=false
YAMA_CODEX_BINARY=codex
YAMA_CODEX_TIMEOUT_SECONDS=120
YAMA_CODEX_MAX_CALLS=100

# Metadata-only monitoring is independently opt-in. No incident text is exported.
YAMA_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Explicit cloud.langfuse.com/us.cloud.langfuse.com or http://127.0.0.1:PORT.
LANGFUSE_BASE_URL=

# Sarvam voice: disabled until account controls and credentials are configured.
# Run npm run voice:setup and voice:server:setup; see docs/voice-integration.md.
YAMA_VOICE_LIVE_ENABLED=false
YAMA_SARVAM_DATA_POLICY_ACKNOWLEDGED=false
SARVAM_API_KEY=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=REPLACE_WITH_GENERATED_LOCAL_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_GENERATED_LOCAL_SECRET
# Generated absolute interpreter path; separate from YAMA_AGENT_PYTHON.
YAMA_VOICE_PYTHON=/ABSOLUTE/PROJECT/PATH/.venv-voice/bin/python
YAMA_VOICE_SESSION_SECONDS=120
# Lifetime reservations, shared across all demo sessions. Never refunded automatically.
YAMA_VOICE_MAX_SECONDS=300
YAMA_VOICE_MAX_TTS_CALLS=20

# Public lookup: authored fixtures, with no provider requests, by default.
# See docs/public-web.md before enabling; never put credentials in browser variables.
YAMA_PUBLIC_WEB_PROVIDER=fixture
YAMA_PUBLIC_WEB_LIVE_ENABLED=false
YAMA_PUBLIC_WEB_DATA_POLICY_ACKNOWLEDGED=false
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Lifetime reservations shared across reports, retained after ambiguous failures.
YAMA_PUBLIC_WEB_MAX_SEARCHES=10
YAMA_PUBLIC_WEB_MAX_PAGES=15
YAMA_PUBLIC_WEB_MAX_EXA_MICRO_USD=100000
YAMA_PUBLIC_WEB_MAX_FIRECRAWL_CREDITS=50

# Notification outbox: local captures only by default. See docs/notifications.md.
YAMA_MAIL_PROVIDER=fixture
YAMA_MAIL_LIVE_ENABLED=false
YAMA_MAIL_DATA_POLICY_ACKNOWLEDGED=false
YAMA_MAIL_RESEND_DOMAIN_VERIFIED=false
# Lifetime transport-attempt ceiling; fallback consumes another reservation.
YAMA_MAIL_MAX_ATTEMPTS=10
RESEND_API_KEY=
YAMA_MAIL_FROM=
YAMA_MAIL_REPLY_TO=
YAMA_MAIL_FALLBACK_ENABLED=false
# oauth2 uses a supplied access token, without automatic refresh; app_password is optional.
YAMA_MAIL_GMAIL_AUTH=oauth2
GMAIL_USER=
GMAIL_ACCESS_TOKEN=
GMAIL_APP_PASSWORD=

# Billing: fixture ledger; hosted Dodo test checkout only, never live charges.
# See docs/billing.md; billing:setup generates a private fixture signing key.
YAMA_BILLING_PROVIDER=fixture
YAMA_DODO_TEST_ENABLED=false
YAMA_DODO_DATA_POLICY_ACKNOWLEDGED=false
YAMA_BILLING_MAX_API_CALLS=50
YAMA_BILLING_FIXTURE_WEBHOOK_KEY=REPLACE_WITH_GENERATED_LOCAL_SECRET
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_BUSINESS_ID=
